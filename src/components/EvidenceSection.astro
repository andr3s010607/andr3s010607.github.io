---
import type { Evidence, EvidenceCategory } from '../utils/evidencias';
import EvidenceCard from './EvidenceCard.astro';

interface Props {
  category: EvidenceCategory;
  evidences: Evidence[];
}

const { category, evidences } = Astro.props;
const total = evidences.length;
---

<section id={category.id} class="scroll-mt-24 py-9 first:pt-0 last:pb-0" aria-labelledby={category.id + '-title'}>
  <div class="flex flex-col justify-between gap-4 border-b border-slate-200 pb-5 dark:border-slate-800 sm:flex-row sm:items-end">
    <div>
      <p class="section-kicker">{category.title}</p>
      <h3 id={category.id + '-title'} class="mt-3 font-heading text-2xl font-bold text-slate-900 dark:text-white">{category.title}</h3>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">{category.description}</p>
    </div>
    <p class="shrink-0 text-sm font-medium text-slate-500 dark:text-slate-400">
      {total === 1 ? '1 evidencia publicada' : total + ' evidencias publicadas'}
    </p>
  </div>

  {total > 0 ? (
    <div class="mt-6 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {evidences.map((evidence) => (
        <EvidenceCard evidence={evidence} categoryTitle={category.title} />
      ))}
    </div>
  ) : (
    <div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-8 dark:border-slate-700 dark:bg-slate-900/50">
      <p class="font-medium text-slate-800 dark:text-slate-200">Aún no se han publicado evidencias en esta categoría.</p>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
        Agrega archivos a la carpeta correspondiente del repositorio y aparecerán aquí después de compilar y publicar el sitio.
      </p>
    </div>
  )}
</section>
