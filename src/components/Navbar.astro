---
import { EVIDENCE_LINKS, NAV_LINKS, OWNER_NAME } from '../config';
import { resolvePath } from '../utils/navigation';
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl dark:border-slate-800 dark:bg-[#09090b]/90">
  <div class="mx-auto flex h-[4.75rem] max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a href={resolvePath('/#inicio')} class="group flex min-w-0 items-center gap-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-[#09090b]">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary-700 text-sm font-extrabold text-white shadow-lg shadow-primary-900/20 transition-transform group-hover:scale-105 dark:bg-primary-500">
        GR
      </span>
      <span class="min-w-0 truncate text-left font-heading text-sm font-bold leading-tight text-slate-900 dark:text-white sm:text-base">
        {OWNER_NAME}
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {NAV_LINKS.map((link) => (
        <a href={resolvePath(link.href)} class="nav-link">{link.label}</a>
      ))}
      <details class="group relative">
        <summary class="nav-link list-none cursor-pointer [&::-webkit-details-marker]:hidden">
          Evidencias
          <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div class="absolute right-0 top-[calc(100%+0.75rem)] w-56 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl shadow-slate-900/10 dark:border-slate-700 dark:bg-slate-900">
          {EVIDENCE_LINKS.map((link) => (
            <a href={resolvePath(link.href)} class="dropdown-link">{link.label}</a>
          ))}
        </div>
      </details>
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a href={resolvePath('/#evidencias')} class="inline-flex min-h-10 items-center justify-center rounded-xl bg-primary-700 px-4 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:bg-primary-500 dark:hover:bg-primary-400 dark:focus:ring-offset-[#09090b]">
        Ver evidencias
      </a>
      <button data-theme-toggle type="button" class="theme-button" aria-label="Cambiar tema" aria-pressed="false">
        <svg data-theme-dark-icon class="hidden h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M17.3 13.3A8 8 0 0 1 6.7 2.7a8 8 0 1 0 10.6 10.6Z"></path>
        </svg>
        <svg data-theme-light-icon class="hidden h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 3v1m0 12v1m7-7h-1M4 10H3m11.95-4.95-.7.7m-8.5 8.5-.7.7m9.2 0-.7-.7m-8.5-8.5-.7-.7M13.5 10A3.5 3.5 0 1 1 6.5 10a3.5 3.5 0 0 1 7 0Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path>
        </svg>
      </button>
    </div>

    <div class="flex items-center gap-1 lg:hidden">
      <button data-theme-toggle type="button" class="theme-button" aria-label="Cambiar tema" aria-pressed="false">
        <svg data-theme-dark-icon class="hidden h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M17.3 13.3A8 8 0 0 1 6.7 2.7a8 8 0 1 0 10.6 10.6Z"></path>
        </svg>
        <svg data-theme-light-icon class="hidden h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 3v1m0 12v1m7-7h-1M4 10H3m11.95-4.95-.7.7m-8.5 8.5-.7.7m9.2 0-.7-.7m-8.5-8.5-.7-.7M13.5 10A3.5 3.5 0 1 1 6.5 10a3.5 3.5 0 0 1 7 0Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path>
        </svg>
      </button>
      <button id="mobile-menu-button" type="button" class="theme-button" aria-controls="mobile-menu" aria-expanded="false">
        <span class="sr-only">Abrir menú de navegación</span>
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3.5 5.5h13M3.5 10h13M3.5 14.5h13" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-[#09090b] lg:hidden" aria-label="Navegación móvil">
    <div class="mx-auto flex max-w-7xl flex-col gap-1 sm:px-2">
      {NAV_LINKS.map((link) => (
        <a href={resolvePath(link.href)} class="mobile-nav-link">{link.label}</a>
      ))}
      <details class="rounded-xl">
        <summary class="mobile-nav-link cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <span>Evidencias</span>
          <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div class="mb-1 ml-3 flex flex-col border-l border-slate-200 pl-3 dark:border-slate-700">
          {EVIDENCE_LINKS.map((link) => (
            <a href={resolvePath(link.href)} class="mobile-evidence-link">{link.label}</a>
          ))}
        </div>
      </details>
      <a href={resolvePath('/#evidencias')} class="mt-2 inline-flex min-h-11 items-center justify-center rounded-xl bg-primary-700 px-4 text-sm font-semibold text-white transition-colors hover:bg-primary-800 dark:bg-primary-500 dark:hover:bg-primary-400">
        Ver evidencias
      </a>
    </div>
  </nav>
</header>

<script>
  function setupNavbar() {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (menuButton && mobileMenu && menuButton.dataset.menuBound !== 'true') {
      menuButton.dataset.menuBound = 'true';
      menuButton.addEventListener('click', () => {
        const willOpen = mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden', !willOpen);
        menuButton.setAttribute('aria-expanded', String(willOpen));
      });

      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          menuButton.setAttribute('aria-expanded', 'false');
        });
      });
    }

    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      const isDark = document.documentElement.classList.contains('dark');
      button.setAttribute('aria-pressed', String(isDark));
      button
        .querySelector('[data-theme-dark-icon]')
        ?.classList.toggle('hidden', isDark);
      button
        .querySelector('[data-theme-light-icon]')
        ?.classList.toggle('hidden', !isDark);

      if (button.dataset.themeBound === 'true') return;
      button.dataset.themeBound = 'true';
      button.addEventListener('click', () => {
        const nextIsDark = document.documentElement.classList.toggle('dark');
        try {
          window.localStorage.setItem('theme', nextIsDark ? 'dark' : 'light');
        } catch {
          // El tema sigue funcionando aunque el navegador bloquee localStorage.
        }
        document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
          toggle.setAttribute('aria-pressed', String(nextIsDark));
          toggle
            .querySelector('[data-theme-dark-icon]')
            ?.classList.toggle('hidden', nextIsDark);
          toggle
            .querySelector('[data-theme-light-icon]')
            ?.classList.toggle('hidden', !nextIsDark);
        });
      });
    });
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>
