---
import { EVIDENCE_LINKS, NAV_LINKS, OWNER_NAME } from '../config';
import { resolvePath } from '../utils/navigation';
---

<footer class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-[#09090b]">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="max-w-xl">
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary-700 text-sm font-extrabold text-white dark:bg-primary-500">GR</span>
          <p class="font-heading text-lg font-bold text-slate-900 dark:text-white">{OWNER_NAME}</p>
        </div>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
          E-portafolio académico para la asignatura Bases de Datos 1.
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-5 gap-y-3 text-sm font-medium" aria-label="Enlaces del pie de página">
        {NAV_LINKS.map((link) => (
          <a href={resolvePath(link.href)} class="footer-link">{link.label}</a>
        ))}
        {EVIDENCE_LINKS.map((link) => (
          <a href={resolvePath(link.href)} class="footer-link">{link.label}</a>
        ))}
      </nav>
    </div>
    <p class="mt-8 border-t border-slate-200 pt-6 text-sm text-slate-500 dark:border-slate-800 dark:text-slate-500">
      © {new Date().getFullYear()} {OWNER_NAME}. Portafolio Bases de Datos 1.
    </p>
  </div>
</footer>
