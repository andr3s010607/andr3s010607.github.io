---
import { OWNER_NAME } from '../config';
import { resolvePath } from '../utils/navigation';
---

<section id="inicio" class="relative isolate overflow-hidden border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-[#09090b]">
  <div class="database-grid absolute inset-0 -z-20 opacity-70 dark:opacity-40" aria-hidden="true"></div>
  <div class="absolute -left-32 top-8 -z-10 h-80 w-80 rounded-full bg-primary-300/25 blur-3xl dark:bg-primary-900/30" aria-hidden="true"></div>
  <div class="absolute -right-24 bottom-0 -z-10 h-96 w-96 rounded-full bg-accent-300/20 blur-3xl dark:bg-accent-900/20" aria-hidden="true"></div>

  <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-[1.08fr_0.92fr] lg:gap-12 lg:px-8 lg:py-32">
    <div class="max-w-3xl">
      <p class="section-kicker">
        <span class="inline-block h-2 w-2 rounded-full bg-accent-500"></span>
        E-portafolio académico
      </p>
      <h1 class="mt-6 font-heading text-4xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-5xl lg:text-6xl">
        {OWNER_NAME}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300 sm:text-xl">
        Un espacio para presentar mi proceso de aprendizaje y las evidencias desarrolladas en
        <strong class="font-semibold text-slate-800 dark:text-slate-100">Bases de Datos 1</strong>.
      </p>
      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-400">
        Aquí reuniré actividades, documentos y entregables de forma organizada, clara y fácil de consultar.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={resolvePath('/#presentacion')} class="primary-button">
          Ver presentación
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 10h11m-4-4 4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href={resolvePath('/#evidencias')} class="secondary-button">
          Ver evidencias
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-xl lg:max-w-none" aria-hidden="true">
      <div class="absolute inset-x-10 -bottom-6 h-14 rounded-full bg-primary-900/15 blur-2xl dark:bg-primary-400/10"></div>
      <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white/85 p-5 shadow-2xl shadow-primary-900/10 backdrop-blur dark:border-slate-700 dark:bg-slate-900/85 sm:p-7">
        <div class="flex items-center justify-between border-b border-slate-200 pb-4 dark:border-slate-700">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
          </div>
          <span class="rounded-full bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700 dark:bg-primary-900/60 dark:text-primary-300">Bases de Datos 1</span>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-[1fr_auto_1fr] sm:items-center">
          <div class="schema-card">
            <p class="schema-title">EVIDENCIA</p>
            <span>id</span>
            <span>categoría</span>
            <span>archivo</span>
          </div>
          <div class="flex justify-center text-primary-500">
            <svg class="h-10 w-10 rotate-90 sm:rotate-0" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 24h34m-9-9 9 9-9 9" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="schema-card border-accent-200 dark:border-accent-800">
            <p class="schema-title text-accent-700 dark:text-accent-300">PROCESO</p>
            <span>modelado</span>
            <span>normalización</span>
            <span>SQL</span>
          </div>
        </div>
        <div class="mt-6 grid grid-cols-3 gap-3">
          <div class="h-2 rounded-full bg-primary-200 dark:bg-primary-900"></div>
          <div class="h-2 rounded-full bg-accent-300 dark:bg-accent-800"></div>
          <div class="h-2 rounded-full bg-slate-200 dark:bg-slate-700"></div>
        </div>
      </div>
    </div>
  </div>
</section>
