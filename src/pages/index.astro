---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Presentation from '../components/Presentation.astro';
import EvidenceSection from '../components/EvidenceSection.astro';
import { EVIDENCE_CATEGORIES, getEvidencesByCategory } from '../utils/evidencias';
import { getPortfolioAssets } from '../utils/portfolio-assets';

const [evidencesByCategory, portfolioAssets] = await Promise.all([
  getEvidencesByCategory(),
  getPortfolioAssets(),
]);
---

<BaseLayout>
  <Hero />
  <Presentation avatarUrl={portfolioAssets.avatarUrl} videoUrl={portfolioAssets.videoUrl} />

  <section id="evidencias" class="scroll-mt-24 bg-white py-20 dark:bg-[#09090b] sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-6 border-b border-slate-200 pb-9 dark:border-slate-800 lg:flex-row lg:items-end">
        <div class="max-w-3xl">
          <p class="section-kicker">Bases de Datos 1</p>
          <h2 class="section-title mt-4">Evidencias de aprendizaje</h2>
          <p class="section-description mt-5">
            Un registro organizado de los trabajos desarrollados para la asignatura.
          </p>
        </div>
        <aside class="max-w-md rounded-2xl border border-primary-200 bg-primary-50/70 px-5 py-4 text-sm leading-6 text-primary-900 dark:border-primary-900 dark:bg-primary-900/30 dark:text-primary-100">
          Las evidencias se detectan automáticamente durante el build al agregar archivos en
          <code class="code-inline">public/evidencias/</code>.
        </aside>
      </div>

      <div class="divide-y divide-slate-200 dark:divide-slate-800">
        {EVIDENCE_CATEGORIES.map((category) => (
          <EvidenceSection category={category} evidences={evidencesByCategory[category.id]} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
