---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePath } from '../utils/navigation';
---

<BaseLayout title="Página no encontrada" description="La página solicitada no existe." noindex={true}>
  <section class="flex min-h-[65vh] items-center justify-center px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-2xl text-center">
      <p class="font-heading text-7xl font-extrabold tracking-tight text-primary-700 dark:text-primary-400 sm:text-8xl">404</p>
      <h1 class="mt-5 font-heading text-3xl font-bold text-slate-900 dark:text-white sm:text-4xl">Página no encontrada</h1>
      <p class="mx-auto mt-5 max-w-lg text-base leading-7 text-slate-600 dark:text-slate-400">
        La dirección que buscas no está disponible o pudo haber cambiado.
      </p>
      <a href={resolvePath('/#inicio')} class="primary-button mt-8">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
